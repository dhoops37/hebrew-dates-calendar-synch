  },
  "dependencies": {
    "kysely": "^0.28.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5"
  }
}
