# Copy to .env.local for local development. Never commit .env.local.

# --- Database -----------------------------------------------------------------
# Neon's POOLED connection string, for the web app.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/hebrewdates?sslmode=require

# Neon's DIRECT connection string. Migrations take a session-scoped advisory
# lock and the job runner uses FOR UPDATE SKIP LOCKED; a transaction pooler
# breaks both, so these must not be the same URL.
DATABASE_URL_DIRECT=postgres://user:password@ep-xxx.region.aws.neon.tech/hebrewdates?sslmode=require

# --- Google OAuth -------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs,
# type "Web application". The redirect URI must match EXACTLY, scheme included.
GOOGLE_OAUTH_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Token encryption ---------------------------------------------------------
# Production: the Google Cloud KMS key that wraps stored refresh tokens. A
# crypto KEY name, never a version — pinning writes to a version would make
# rotating the key a silent no-op.
# KMS_KEY_NAME=projects/PROJECT/locations/global/keyRings/hebrew-dates/cryptoKeys/oauth-tokens

# Local development only: 32 bytes, base64. Generate with
#   openssl rand -base64 32
# The application refuses to start in production with this set and no KMS key.
LOCAL_ENVELOPE_MASTER_KEY=

# --- Place search -------------------------------------------------------------
# OpenStreetMap's Nominatim needs no API key, but its usage policy requires a
# User-Agent that identifies the deployment and a contact address. Set this and
# city search goes live; leave it unset and the app falls back to its built-in
# list of 22 cities, which works but will not find most people's town.
#
# Put a real contact in it. An application that cannot be contacted about a
# problem gets blocked rather than emailed.
#   GEOCODER_USER_AGENT=HebrewDates/1.0 (https://your-domain; you@example.com)
GEOCODER_USER_AGENT=

# --- Application --------------------------------------------------------------
APP_URL=http://localhost:3000

# Required by /api/cron/sync, which refuses to run without it rather than
# defaulting to open: anyone able to call it could exhaust the Google quota that
# every user of the deployment depends on. Generate with
#   openssl rand -hex 32
CRON_SECRET=
