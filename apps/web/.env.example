# Copy to .env.local for local development. Never commit .env.local.

# --- Database -----------------------------------------------------------------
# Neon's POOLED connection string, for the web app.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/hebrewdates?sslmode=require

# Neon's DIRECT connection string, used by `pnpm db:migrate` only. Migrations
# hold a session-scoped advisory lock across several statements, which a
# transaction pooler would serve from different connections — so the lock would
# protect nothing. Needed wherever you run migrations from, NOT in Vercel: the
# running app uses the pooled string for everything.
DATABASE_URL_DIRECT=postgres://user:password@ep-xxx.region.aws.neon.tech/hebrewdates?sslmode=require

# --- Google OAuth -------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs,
# type "Web application". The redirect URI must match EXACTLY, scheme included.
GOOGLE_OAUTH_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Token encryption ---------------------------------------------------------
# Production: the Google Cloud KMS key that wraps stored refresh tokens. A
# crypto KEY name, never a version — pinning writes to a version would make
# rotating the key a silent no-op.
# KMS_KEY_NAME=projects/PROJECT/locations/global/keyRings/hebrew-dates/cryptoKeys/oauth-tokens

# Production: the credential that lets the app use that KMS key. The WHOLE
# service-account JSON file, flattened onto one line.
#
# There are two Google JSON files in this setup and they are NOT
# interchangeable. Confusing them fails at decryption time, long after deploy,
# with an unhelpful error:
#
#   - the SERVICE-ACCOUNT key   (IAM & Admin -> Service Accounts -> Keys)
#     -> the entire file goes here, on one line:
#          tr -d '\n' < service-account.json
#
#   - the OAUTH CLIENT json     (APIs & Services -> Credentials)
#     -> NOT used here. Only two values are taken out of it, and they go into
#        GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET above.
#
# Unset locally: LOCAL_ENVELOPE_MASTER_KEY replaces KMS in development.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Local development only: 32 bytes, base64. Generate with
#   openssl rand -base64 32
# The application refuses to start in production with this set and no KMS key.
LOCAL_ENVELOPE_MASTER_KEY=

# --- Place search -------------------------------------------------------------
# OpenStreetMap's Nominatim needs no API key, but its usage policy requires a
# User-Agent that identifies the deployment and a contact address. Set this and
# city search goes live; leave it unset and the app falls back to its built-in
# list of 22 cities, which works but will not find most people's town.
#
# Put a real contact in it. An application that cannot be contacted about a
# problem gets blocked rather than emailed.
#   GEOCODER_USER_AGENT=HebrewDates/1.0 (https://your-domain; you@example.com)
GEOCODER_USER_AGENT=

# Optional. Point at a self-hosted Nominatim or a compatible mirror instead of
# the public service.
# GEOCODER_ENDPOINT=https://nominatim.example.internal

# Optional, and only honoured together with GEOCODER_ENDPOINT. Lifts the shared
# one-request-per-second gate, which a self-hosted instance does not need.
# Setting it against the public endpoint is exactly what the usage policy
# forbids, which is why it cannot be enabled on its own.
# GEOCODER_UNTHROTTLED=1

# --- Application --------------------------------------------------------------
APP_URL=http://localhost:3000

# Required by /api/cron/sync, which refuses to run without it rather than
# defaulting to open: anyone able to call it could exhaust the Google quota that
# every user of the deployment depends on. Generate with
#   openssl rand -hex 32
CRON_SECRET=
