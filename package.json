{
  "name": "hebrew-dates",
  "private": true,
  "version": "0.1.0",
  "description": "Enter a Hebrew date once and keep seeing it on the correct Gregorian date every year.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter \"./packages/*\" test",
    "test:watch": "pnpm --filter @hebrew-dates/engine test:watch",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @hebrew-dates/web dev",
    "db:verify": "psql -v ON_ERROR_STOP=1 -f db/migrations/0001_init.sql && psql -f db/tests/constraints.sql"
  }
}
