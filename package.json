{
  "name": "hebrew-dates",
  "private": true,
  "version": "0.1.0",
  "description": "Enter a Hebrew date once and keep seeing it on the correct Gregorian date every year.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "test:watch": "pnpm --filter @hebrew-dates/engine test:watch",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @hebrew-dates/web dev",
    "db:migrate": "pnpm --filter @hebrew-dates/db db:migrate",
    "db:status": "pnpm --filter @hebrew-dates/db db:status",
    "test:db": "pnpm --filter @hebrew-dates/db test"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.28",
      "sharp": "^0.35.4"
    }
  }
}
